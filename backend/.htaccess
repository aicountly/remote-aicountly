# ---------------------------------------------------------------------------
# AICOUNTLY Remote API — Apache config for <document root>/api on cPanel.
#
# CodeIgniter expects its `public/` directory to be the document root, but the
# deploy target here is a folder *inside* the site's document root. This file
# bridges the two: every request that arrives at `api/` is rewritten into
# `api/public/`, where CodeIgniter's own .htaccess and front controller take
# over.
#
# The alternative — deploying `public/` to `api/` and the framework above the
# document root — needs a second rsync target and a second secret, and gives a
# layout that no longer matches the repository. This keeps one target, and the
# directories that must not be served are denied below and by their own
# .htaccess files.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # No RewriteBase on purpose: Apache resolves the substitution against
  # whichever directory this file sits in, so the API works at <docroot>/api
  # and at the root of a dedicated vhost without editing this line.

  # Everything else deployed beside public/ is private: framework and
  # application code, logs and caches, migrations, operator scripts, tests, and
  # the CLI entry point and dependency manifests. Refused before anything is
  # rewritten, so nothing below can route a request around it (a read-only scan
  # found GET /api/spark answering 500 where it should be refused). None of
  # these is an API route and public/ is not listed, so the front controller is
  # untouched. The name may be followed by a path (spark/x, app/Config/...).
  RewriteRule ^(app|system|vendor|writable|scripts|tests|database|build|deploy)(/|$) - [F,L]
  RewriteRule ^(spark|composer\.json|composer\.lock|phpunit[^/]*)(/|$) - [F,L]

  # Already inside public/ — CodeIgniter's own rules handle it from here.
  RewriteRule ^public/ - [L]

  # Everything else goes into public/.
  RewriteRule ^(.*)$ public/$1 [L]

  # Apache does not hand the Authorization header to PHP under CGI/FastCGI
  # unless it is copied explicitly. Without this the auth relay forwards no
  # credential, the portal answers 401, and sign-in fails for everyone with
  # nothing in the logs to explain it.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Without mod_rewrite there is no safe way to serve this layout, so serve
# nothing rather than exposing the framework directories.
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

Options -Indexes

# The API's .env sits inside the document root, so without this it would be
# fetchable over HTTP at https://remote.aicountly.com/api/.env.
RedirectMatch 404 /\.(?!well-known)

# PHP's error_log at any depth: api/error_log is rewritten into public/, and
# public/error_log (where PHP writes next to the front controller) is a real
# file, so CodeIgniter's own rules would serve it.
RedirectMatch 404 (^|/)error_log$

# Belt and braces for hosts that ignore the per-directory files: nothing with
# these extensions is ever meant to be served from the API.
<FilesMatch "\.(env|log|lock|neon|dist|md|sql|sh|bak)$">
  Require all denied
</FilesMatch>

# PHP and cPanel write `error_log` and `php_errorlog` into the directory a
# script failed in. They have no extension, so the rule above misses them, and
# they carry request URLs and stack traces.
<FilesMatch "^(error_log|php_errorlog)$">
  Require all denied
</FilesMatch>

# The framework's CLI entry point and the dependency and test manifests at the
# root. The rules at the top refuse them by URL; this refuses the file itself,
# whichever way a request reached it.
<FilesMatch "^(spark|composer\.json|composer\.lock|phpunit[^/]*)$">
  Require all denied
</FilesMatch>
