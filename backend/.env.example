#----------------------------------------------------------------------------
# AICOUNTLY Remote API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# See docs/DEPLOYMENT.md.
#----------------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# production | development. Never `development` on a public host: it turns on
# the debug toolbar and puts real exception messages in API responses.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://remote.aicountly.com/api/'

# HTTPS only. Screen capture requires a secure context in every browser, and
# this API carries session credentials. Leave this on.
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (PostgreSQL)
#--------------------------------------------------------------------
# On cPanel the account name prefixes both the database and the user, so a
# database created as `remote` becomes `<cpaneluser>_remote`. Grant the user ALL
# PRIVILEGES, and keep the hostname as localhost.
#
# The database NAME and USERNAME come from Console (Console > SaaS Database Details), which
# records them once per product and environment. In Console, generate Remote's key on this
# deployment's row (Generate key; Console shows it ONCE, and it starts with sdb_) and set:
# CONSOLE_API_URL is the Console API base INCLUDING /api (https://console.aicountly.org/api).
CONSOLE_API_URL =
# The variable is called CONSOLE_DB_DETAILS_KEY. A key put under any other name leaves Console
# unused and the local database.default.database / .username in charge (and with those
# commented out there is no database at all, which `php spark remote:db-check` reports).
CONSOLE_DB_DETAILS_KEY =
# The API asks GET $CONSOLE_API_URL/database-details/resolve with that key as a bearer token
# (app/Support/ConsoleDatabaseDetails.php) whenever it builds its database config. Answers are
# cached (5 minutes); if Console is briefly unreachable the last good answer (up to 7 days old)
# is used and logged. A revoked key or inactive row is never covered by the cache. A key for the
# other environment (production vs sandbox) is refused: the environment is read from the host
# of app.baseURL, or from REMOTE_ENVIRONMENT = production|sandbox if you set it.
# Only the name and username come from Console (the same split Connect uses): it never holds a
# password, and any other field in its answer is ignored. Hostname, port and password stay here
# and are still required (the password must belong to the user Console names for this row).
database.default.hostname = localhost
database.default.password =
database.default.DBDriver = Postgre
database.default.port = 5432
# LOCAL FALLBACK ONLY - used when CONSOLE_API_URL / CONSOLE_DB_DETAILS_KEY are not both set
# (local development, `php spark migrate` against a scratch database). Do not set these on a
# deployed server: while the Console settings are present they are not read.
# database.default.database = aicountly_remote
# database.default.username = aicountly_remote

# After setting these, `php spark remote:db-check` shows where each setting comes from and whether
# the database accepts it; GET /api/health reports `databaseSource` ("console" when Console
# supplies the name and username) and, on a failure, `databaseReason` and `databaseHint`.

# Never `true` in production: it turns a query error into a stack trace in the
# response.
database.default.DBDebug = false

#--------------------------------------------------------------------
# REMOTE — application secrets
#--------------------------------------------------------------------

# Shared with the Node signalling service. The API signs the short-lived
# tokens; the signalling service only verifies them. Both must hold the same
# value, and it must be long and random:
#
#     openssl rand -base64 48
#
# Empty disables live sessions entirely — the API refuses to mint a token
# rather than issuing an unsigned one anyone could forge.
remote.signallingSecret =

# Shared with the AICOUNTLY products that launch Remote with signed company
# context (§6C). Empty means Remote refuses launch context rather than
# accepting a company id it cannot verify.
remote.contextSecret =
remote.contextIssuer = https://my.aicountly.com
remote.contextAudience = aicountly-remote

# Seconds a launch-context token stays acceptable, whatever its own `exp` says.
remote.contextMaxAgeSeconds = 300

# Products permitted to launch Remote with signed context.
remote.sourceProductAllowlist = BOOKS,HRMS,AUDITOR,INVENTORY,ADVISOR,MANAGE,PULSE,CONNECT

#--------------------------------------------------------------------
# REMOTE — endpoints
#--------------------------------------------------------------------
remote.appUrl = https://remote.aicountly.com
remote.signalUrl = wss://remote.aicountly.com/signal

# The AICOUNTLY portal auth API. my.aicountly.com serves BOTH production and
# sandbox — sandbox.aicountly.com is a login redirect only and does not answer
# seskey or validatesession. See docs/auth/AICOUNTLY_AUTH_WORKFLOW.md.
# remote.portalAuthBase = https://my.aicountly.com

# Optional platform directory API (company masters and membership). Unset,
# Remote relies on its local projection, which a verified launch context
# populates.
# remote.directoryBase =
# remote.directoryToken =

# Aicountly Manage decides who belongs to a company. Remote asks it, with the
# signed-in person's own session, before honouring a company they were last
# seen in, and drops the access it holds when Manage says they have left.
# Sandbox deployments point this at https://manage.gh.aicountly.com.
# remote.manageBase = https://manage.aicountly.com
# Seconds a positive answer is trusted before the person is asked about again.
# remote.membershipVerifySeconds = 300
# How long a confirmation is still honoured when Manage cannot be reached (or
# when no session of the person's is in hand, as for a desktop device).
# remote.membershipGraceSeconds = 86400
# Development only; ignored in production, where Manage is always asked.
# remote.membershipEnforcement = true

#--------------------------------------------------------------------
# MANAGE'S COMPANY LIFECYCLE (docs/COMPANY_LIFECYCLE.md)
#--------------------------------------------------------------------
# An organisation whose Remote subscription lapsed is read-only (sessions in
# progress can still end), then its Remote data is purged by the cron worker.
# LIFECYCLE_WEBHOOK_SECRET signs POST /api/internal/manage/company-lifecycle and
# the acks (>= 32 characters, `openssl rand -hex 32`); Manage holds the same
# value as LIFECYCLE_WEBHOOK_SECRET_REMOTE. Unset: events answer 503 and nothing
# is restricted or purged. MANAGE_API_URL is where acks go — no default, so a
# sandbox never acks production (sandbox https://manage.gh.aicountly.com).
# Optional: MANAGE_PRODUCT_SERVICE_KEY (the worker asks Manage just before each
# purge whether it still stands), LIFECYCLE_MANIFEST.
# LIFECYCLE_WEBHOOK_SECRET =
# MANAGE_API_URL = https://manage.aicountly.com
# MANAGE_PRODUCT_SERVICE_KEY =

#--------------------------------------------------------------------
# REMOTE — ICE (STUN / TURN)
#--------------------------------------------------------------------
# STUN alone is enough for most networks. TURN is what makes the strict ones
# work — without it, two peers behind symmetric NAT simply cannot connect, and
# Remote says so rather than showing "reconnecting" forever.
remote.stunUrls = stun:stun.l.google.com:19302

# A self-hosted coturn, reachable over TLS on 5349 so it survives restrictive
# firewalls. See docs/ARCHITECTURE.md for a working coturn configuration.
# remote.turnUrls = turns:turn.aicountly.com:5349?transport=tcp,turn:turn.aicountly.com:3478

# PREFERRED: coturn's `use-auth-secret` mode. The API mints a username/password
# pair that expires in an hour, so what reaches the browser is useless
# afterwards and the secret itself never leaves this server.
# remote.turnStaticAuthSecret =
# remote.turnCredentialTtl = 3600

# Fallback: a fixed credential pair. Simpler, but the credential is handed to
# every browser and does not expire — only appropriate for a TURN that is not
# reachable from the open internet.
# remote.turnUsername =
# remote.turnCredential =

# ── TURN relay nodes (lib/ice-kit; docs/ICE_CONTRACT.md) ─────────────────────
#
# The same keys in AICOUNTLY Remote and AICOUNTLY Connect: configure a relay once
# and both products serve it. When WEBRTC_TURN_NODES is set it replaces the
# single-pool TURN settings (remote.turnUrls,
# remote.turnStaticAuthSecret, remote.turnUsername/Credential above).
#
# Lists are comma-separated WITHOUT spaces. CodeIgniter's .env parser rejects an
# unquoted value containing a space, and that rejection takes the whole API down.
#
# A node with no STATUS is `disabled`, and a disabled node is never handed to a
# client. Greater Noida stays disabled until it has passed
#   php lib/ice-kit/bin/probe.php --bootstrap=config/ice-kit.php --node=ncr --allocate
# and a browser relay check (web/src/ice-kit/tools/relay-check.mjs).
#
# WEBRTC_TURN_NODES = mum,ncr
#
# WEBRTC_TURN_NODE_MUM_HOST = turn-mum.aicountly.com
# WEBRTC_TURN_NODE_MUM_STATUS = active
# WEBRTC_TURN_NODE_MUM_PRIORITY = 10
# WEBRTC_TURN_NODE_MUM_REGION = in-west
# WEBRTC_TURN_NODE_MUM_LABEL = Mumbai
# WEBRTC_TURN_NODE_MUM_TRANSPORTS = udp,tcp,tls
# WEBRTC_TURN_NODE_MUM_PORT = 3478
# WEBRTC_TURN_NODE_MUM_TLS_PORT = 443
#
# WEBRTC_TURN_NODE_NCR_HOST = turn-ncr.aicountly.com
# WEBRTC_TURN_NODE_NCR_STATUS = disabled
# WEBRTC_TURN_NODE_NCR_PRIORITY = 20
# WEBRTC_TURN_NODE_NCR_REGION = in-north
# WEBRTC_TURN_NODE_NCR_LABEL = "Greater Noida"
# WEBRTC_TURN_NODE_NCR_TRANSPORTS = udp,tcp,tls
# WEBRTC_TURN_NODE_NCR_TLS_PORT = 443
#
# coturn's static-auth-secret, shared by every node unless a node sets its own
# WEBRTC_TURN_NODE_<ID>_SECRET. Server-side only: it never reaches a client, a
# log, a response or this repository.
# WEBRTC_TURN_STATIC_AUTH_SECRET =
#
# Credential lifetime in seconds (60..86400). Clients renew at 80% of it and
# move a relayed connection onto the new credential before the old one expires.
# WEBRTC_TURN_TTL = 3600
#
# Relay nodes per client (1..4): each TURN URL is an allocation a browser makes.
# WEBRTC_TURN_MAX_NODES = 2
#
# Secrets are NOT set here. Each node's coturn static-auth-secret is its own
# (WEBRTC_TURN_NODE_MUM_SECRET, WEBRTC_TURN_NODE_NCR_SECRET) and is written into the
# server's .env by the deploy over SSH stdin (bin/ops/inject-turn-secrets.sh) from
# repository secrets. Production holds Mumbai's only. Do not also set the shared
# WEBRTC_TURN_STATIC_AUTH_SECRET alongside per-node secrets.
#
# A credential for a client that cannot renew it (the Remote desktop agent) lasts the
# rest of its session plus five minutes, between WEBRTC_TURN_TTL and this (seconds,
# max 86400).
# WEBRTC_TURN_SESSION_TTL_MAX = 28800
#
# Whether a renewal restarts ICE on relayed connections (true), or only refreshes the
# credential on the live connection (false). Keep true until docs/TURN_VALIDATION_RUNBOOK.md
# step A3 shows the real relays keep established allocations alive past expiry.
# WEBRTC_TURN_RESTART_ON_RENEWAL = true
#
# Node health, written every five minutes by the turn-probe job (bin/ops/jobs.txt).
# A node is skipped after this many consecutive failed probes, a result older than
# the max age is ignored, and the last servable node is never removed on its word.
# Default writable/ice/turn-health.json; set an absolute path to keep it elsewhere.
# WEBRTC_TURN_HEALTH_FILE = /home/account/turn-health.json
# WEBRTC_TURN_HEALTH_FAILURES = 2
# WEBRTC_TURN_HEALTH_MAX_AGE = 900

#--------------------------------------------------------------------
# REMOTE — limits and feature flags
#--------------------------------------------------------------------
remote.sessionDefaultMinutes = 60
remote.inviteDefaultMinutes = 10
remote.supportRequestExpiryMinutes = 30

# A flag can only ever REMOVE capability. Company policy is still evaluated
# after it, never instead of it (§67).
remote.allowSafeShare = true
remote.allowMicrophone = true
remote.allowFileTransfer = true
remote.allowExternalGuest = true

# Off in V1. The schema, policy and consent model exist; no recording is
# produced (§38).
remote.allowRecording = false

# Conservative ceiling for browser-to-browser file transfer.
remote.fileTransferMaxBytes = 26214400

#--------------------------------------------------------------------
# REMOTE — the desktop agent
#--------------------------------------------------------------------
# The global switch for AICOUNTLY Remote for Windows. Like every flag here it
# can only REMOVE capability: the plan entitlement, the company policy and the
# permission are still evaluated after it.
remote.allowDesktopAgent = true

# A device authentication challenge. Short on purpose — the agent signs it
# immediately, and it is single-use whatever happens.
remote.deviceChallengeTtl = 120

# How long a device access credential lasts before the agent proves possession
# of its key again. Minutes, deliberately: there is no permanent bearer token
# that is a machine's identity.
remote.deviceTokenTtl = 900

# A device's own presence-room token. Longer, because the agent holds one
# connection open with it rather than making a call per request.
remote.devicePresenceTokenTtl = 540

# How long after its last heartbeat a machine stops being shown as reachable.
# A crashed agent gets no chance to say it is going.
remote.devicePresenceStaleSeconds = 180

# The clipboard ceiling the AGENT is told to use. The agent adopts this rather
# than deciding for itself, so the two cannot disagree.
remote.clipboardMaxBytes = 65536

# The agent build this deployment expects. Advisory — it is what the console
# shows beside an out-of-date agent, not something that refuses a session.
remote.desktopMinimumAgentVersion = 1.0.0

# Where the agent's SIGNED update manifest lives. Empty disables updates, which
# is the shipped default: an updater with no manifest to verify is an updater
# that must not run. See docs/desktop/WINDOWS_RELEASE.md.
# remote.desktopUpdateFeedUrl =

#--------------------------------------------------------------------
# REMOTE — support and CORS
#--------------------------------------------------------------------
# Local ids of AICOUNTLY staff who may answer support requests. Normally left
# empty: acceptance is driven by the `remote.support.accept` permission.
# remote.supportTechnicianUserIds =

# Origins allowed to call this API cross-origin. Both deployed environments are
# same-origin with their app, so leave this empty in production — it exists for
# `npm run dev` against a deployed API.
# remote.corsAllowedOrigins = http://localhost:5173

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Not used by Remote today (no encrypted cookies, no encrypted sessions), but
# CodeIgniter expects one to exist. Generate with: php spark key:generate
# encryption.key =

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
# 4 = warnings and above. Levels below that log every request and fill the
# disk on a shared host.
logger.threshold = 4
