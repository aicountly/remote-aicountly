# Non-secret TURN settings for the Remote SANDBOX (remote.gh.aicountly.com) — first real-server and product testing.
# Applied with:  ssh <sandbox> "bash <docroot>/api/bin/ops/apply-turn-config.sh" < turn-observe.remote.env
# Secrets (node secrets, ledger password) are NOT here: they go through inject-turn-secrets.sh, stdin only.
#
# ADMISSION IS OBSERVE: the books are kept and every decision is logged, nobody is refused. The capacity numbers
# below are PLACEHOLDERS (assumptions): they size the books and the reconciliation report until the runbook Part F
# measurements replace them. Greater Noida is `active` HERE (staging) so it can be validated in isolation; the
# production .env keeps it `disabled` (the production deploy passes --keep-out=ncr).
WEBRTC_TURN_ADMISSION=observe
WEBRTC_TURN_NODES=mum,ncr
WEBRTC_STUN_URLS=stun:turn-mum.aicountly.com:3478,stun:turn-ncr.aicountly.com:3478

WEBRTC_TURN_NODE_MUM_HOST=turn-mum.aicountly.com
WEBRTC_TURN_NODE_MUM_STATUS=active
WEBRTC_TURN_NODE_MUM_PRIORITY=10
WEBRTC_TURN_NODE_MUM_REGION=in-west
WEBRTC_TURN_NODE_MUM_LABEL=Mumbai
WEBRTC_TURN_NODE_MUM_TRANSPORTS=udp,tcp,tls
WEBRTC_TURN_NODE_MUM_PORT=3478
WEBRTC_TURN_NODE_MUM_TLS_PORT=443
WEBRTC_TURN_NODE_MUM_LAT=19.0760
WEBRTC_TURN_NODE_MUM_LON=72.8777
WEBRTC_TURN_NODE_MUM_MAX_ALLOCATIONS=4000
WEBRTC_TURN_NODE_MUM_MAX_MBPS=400
WEBRTC_TURN_NODE_MUM_TIERS=paid,free
WEBRTC_TURN_NODE_MUM_PAID_RESERVE_PERCENT=50

WEBRTC_TURN_NODE_NCR_HOST=turn-ncr.aicountly.com
WEBRTC_TURN_NODE_NCR_STATUS=active
WEBRTC_TURN_NODE_NCR_PRIORITY=10
WEBRTC_TURN_NODE_NCR_REGION=in-north
WEBRTC_TURN_NODE_NCR_LABEL=Noida
WEBRTC_TURN_NODE_NCR_TRANSPORTS=udp,tcp,tls
WEBRTC_TURN_NODE_NCR_PORT=3478
WEBRTC_TURN_NODE_NCR_TLS_PORT=443
WEBRTC_TURN_NODE_NCR_LAT=28.4744
WEBRTC_TURN_NODE_NCR_LON=77.5040
WEBRTC_TURN_NODE_NCR_MAX_ALLOCATIONS=4000
WEBRTC_TURN_NODE_NCR_MAX_MBPS=400
WEBRTC_TURN_NODE_NCR_TIERS=paid,free
WEBRTC_TURN_NODE_NCR_PAID_RESERVE_PERCENT=50

WEBRTC_TURN_PAID_RESERVE_PERCENT=50
WEBRTC_TURN_BUSY_AT=70
WEBRTC_TURN_SHED_FREE_AT=85
WEBRTC_TURN_FALLBACK_TRANSPORTS=tls

# The shared capacity ledger — STAGING database, separate from any production ledger (see docs/STAGING_TURN_DEPLOYMENT.md §4).
WEBRTC_TURN_LEDGER_DSN=pgsql:host=127.0.0.1;port=5432;dbname=aicountly_turn_staging
WEBRTC_TURN_LEDGER_USER=turn_ledger_staging

# Licence mapping. STAGING-ONLY test plan code, so a paid test company can exist without any real plan being decided.
# WEBRTC_TURN_LICENCE_FEED is deliberately NOT set: enforcement stays held (enforceBlockedBy) until the feed is real.
WEBRTC_TURN_PAID_PLAN_CODES=STAGING_PAID_TEST
WEBRTC_TURN_FREE_PLAN_CODES=REMOTE_FREE,REMOTE_PROFESSIONAL
WEBRTC_TURN_ENTITLEMENT_MAX_AGE_HOURS=48
