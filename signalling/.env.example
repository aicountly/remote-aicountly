# ---------------------------------------------------------------------------
# AICOUNTLY Remote — signalling service environment template
#
# Copy to .env (or set these as real environment variables in whatever runs
# the process: cPanel's "Setup Node.js App", systemd, pm2, a container).
#
# This service holds no database credential and no company data. The one secret
# it needs is the HMAC key it verifies tokens with — the same value the CI4 API
# signs them with.
# ---------------------------------------------------------------------------

# Where to listen. Behind a reverse proxy, bind to loopback and let Apache or
# nginx terminate TLS and forward /signal.
REMOTE_SIGNAL_HOST=127.0.0.1
REMOTE_SIGNAL_PORT=8787

# REQUIRED. Must be byte-identical to `remote.signallingSecret` in the API's
# .env. The service refuses to start without it — with no secret every token
# would verify, and anyone who guessed a room name could join a session.
#
#     openssl rand -base64 48
REMOTE_SIGNALLING_TOKEN_SECRET=

# Origins allowed to open a WebSocket. Empty means "do not check", which is
# only appropriate behind a proxy that already restricts it: the Origin header
# is not a security boundary on its own, since a non-browser client can send
# anything. The signed token is the real gate.
#
# A desktop agent is not a browser and sends no Origin at all. The relay lets a
# connection with no Origin through this check — it was only ever about a page
# on another site — and refuses a wrong one.
REMOTE_SIGNAL_ALLOWED_ORIGINS=https://remote.aicountly.com

# Nothing else is needed for the desktop agent. It joins the same rooms with
# the same tokens; a device presence room is named `device-<uuid>` and the
# token's `knd` claim is what says which kind of room it is. There is no
# separate port, protocol or secret for it — see docs/desktop/ARCHITECTURE.md.
