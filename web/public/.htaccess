# ---------------------------------------------------------------------------
# Apache config for the built SPA on cPanel.
# Vite copies everything in public/ into dist/, so this ships with the build.
# ---------------------------------------------------------------------------

# --- SPA history fallback --------------------------------------------------
# Client-side routes have no file on disk. Send anything that is not a real
# file or directory to index.html so a refresh or deep link does not 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never swallow Let's Encrypt validation requests.
  RewriteRule ^\.well-known/ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed asset filenames change on every build, so cache them hard.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or a deploy is invisible to clients.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"

  # Screen capture and microphone are the product; they are permitted for this
  # origin and denied to anything embedded. `display-capture=(self)` is what
  # allows getDisplayMedia to run at all under Permissions Policy.
  Header set Permissions-Policy "display-capture=(self), microphone=(self), camera=(), geolocation=()"

  # Content Security Policy for the app (§29).
  #
  # The API's CSP is `default-src 'none'` because it only ever returns JSON.
  # This one has to permit an actual application, so each directive is the
  # narrowest thing that still works:
  #
  #   script-src 'self'      — Vite emits hashed files; no inline script, no
  #                            eval. https://www.googletagmanager.com is
  #                            allowlisted for GA4's gtag.js only — without it
  #                            the browser silently blocks the script load and
  #                            no analytics ever reaches GA4, with only a CSP
  #                            violation in the console to show for it.
  #   style-src  … 'unsafe-inline'
  #                          — React sets element styles for the pointer and
  #                            annotation overlays, whose values are computed at
  #                            runtime and cannot be hashed
  #   img-src    … blob:     — video poster frames; https://www.google-analytics.com
  #                            covers GA4's no-JS pixel fallback
  #   media-src  blob:       — the MediaStream attached to the <video> element
  #   connect-src … wss:     — the signalling service, and the API (the
  #                            trailing `https:` scheme-source already permits
  #                            GA4's collect beacon, so no addition needed there)
  #   frame-ancestors 'none' — Remote must never be embedded; a framed screen
  #                            share is a screen share the user cannot see the
  #                            context of
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.google-analytics.com; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://my.aicountly.com wss: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Deny access to any dotfile that somehow lands in the docroot (e.g. .env),
# except .well-known which must stay reachable for SSL renewal.
RedirectMatch 404 /\.(?!well-known)
