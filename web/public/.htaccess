# --- Maintenance mode -----------------------------------------------------
# CANONICAL COPY: console-react-app/ops/estate/kit/web/maintenance.htaccess
# Installed by ops/estate/install-maintenance.py. COPY, DON'T EDIT.
#
# Switched by the PRESENCE OF A FILE, not by .env, and deliberately so: this has to work at the
# moment the app does not. Mid-migration PHP is being reinstalled, the database is gone and .env may
# not have been written yet — anything that needed PHP to read a variable would fail exactly when the
# page is wanted. A file Apache can stat needs nothing but Apache.
#
#   on   : touch <docroot>/.maintenance
#   off  : rm -f <docroot>/.maintenance
#
# scripts/ops/maintenance.sh does both, plus the .maintenance.json notice the page reads.
#
# This block MUST sit above the SPA history fallback. The fallback sends anything that is not a real
# file to index.html; if it ran first the app shell would be served and the user would get a broken
# app instead of this page.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # The page itself, and the notice file it reads, must stay reachable while maintenance is on —
  # otherwise the rewrite would send the maintenance page to the maintenance page.
  RewriteCond %{REQUEST_URI} ^/(maintenance\.html|\.maintenance\.json)$
  RewriteRule ^ - [L]

  # The maintenance CONTROL endpoint must keep answering while maintenance is ON, or the switch is
  # one-way: Console could take a site down and would then be rewritten to this very page when it
  # tried to bring it back, with no way in but SSH. Only these two exact paths are let through —
  # allowlisting /api wholesale would leave the product's API serving traffic through a maintenance
  # window, which is the thing the window is for.
  #   /api/internal/maintenance   the route in every product with a router
  #   /api/maintenance.php        the file-is-the-route form (aicountly.com, aicountly.io)
  RewriteCond %{REQUEST_URI} ^/api/(internal/maintenance|maintenance\.php)$
  RewriteRule ^ - [L]

  # Let's Encrypt and the rest of /.well-known keep working, so certificates can still be renewed
  # while the site is down. A migration is exactly when a renewal is likely to fall due.
  RewriteCond %{REQUEST_URI} ^/\.well-known/
  RewriteRule ^ - [L]

  # Operator bypass. Put one IP per line in <docroot>/.maintenance-allow and those addresses get the
  # real site while everyone else gets the page — so the release can be verified before the switch
  # is turned off, rather than after.
  RewriteCond %{DOCUMENT_ROOT}/.maintenance-allow -f
  RewriteCond %{DOCUMENT_ROOT}/.maintenance-allow %{REMOTE_ADDR} [NC]
  RewriteRule ^ - [L]

  # Everything else, while the flag file exists: 503 with the page as the body.
  # 503 (not 200, not 302) is load-bearing. A 200 tells a crawler this IS the page for every URL on
  # the site; Google then deindexes the real content. 503 says "temporarily unavailable, come back",
  # and Retry-After below says when.
  RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
  RewriteRule ^ /maintenance.html [R=503,L]
</IfModule>

<IfModule mod_headers.c>
  # Retry-After on the 503 (one hour). Crawlers honour it; so do some clients.
  <If "-f '%{DOCUMENT_ROOT}/.maintenance'">
    Header always set Retry-After "3600"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </If>

  # The notice file is read cross-origin by OTHER products' maintenance pages, which is how a
  # product can show that the service it depends on is the one that is down. Without this header the
  # browser blocks the read and every linked service reads "Unreachable" whatever its real state.
  <FilesMatch "^\.maintenance\.json$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# The flag and allow files are operator state, never content. Serving .maintenance would leak the
# reason text to anyone who asked for it by name.
<FilesMatch "^\.maintenance(-allow)?$">
  Require all denied
</FilesMatch>

ErrorDocument 503 /maintenance.html
# --- end Maintenance mode -------------------------------------------------

# ---------------------------------------------------------------------------
# Apache config for the built SPA on cPanel.
# Vite copies everything in public/ into dist/, so this ships with the build.
# ---------------------------------------------------------------------------

# HTTPS only: a plain-http request is redirected (301) to the same URL on https.
# It never loops behind a TLS-terminating proxy: a request that arrived over TLS, that the proxy
# marks as https (X-Forwarded-Proto / X-Forwarded-SSL) or that came in on port 443 is left alone.
# localhost and 127.0.0.1 stay on http for local development.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP_HOST} .
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- SPA history fallback --------------------------------------------------
# Client-side routes have no file on disk. Send anything that is not a real
# file or directory to index.html so a refresh or deep link does not 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never swallow Let's Encrypt validation requests.
  RewriteRule ^\.well-known/ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed asset filenames change on every build, so cache them hard.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or a deploy is invisible to clients.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  # HTTPS only from now on (HSTS, one year). Browsers ignore it on plain http, which the rule at the top
  # redirects anyway; `always` also covers error pages.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Screen capture and microphone are the product; they are permitted for this
  # origin and denied to anything embedded. `display-capture=(self)` is what
  # allows getDisplayMedia to run at all under Permissions Policy.
  Header set Permissions-Policy "display-capture=(self), microphone=(self), camera=(), geolocation=()"

  # Content Security Policy for the app (§29).
  #
  # The API's CSP is `default-src 'none'` because it only ever returns JSON.
  # This one has to permit an actual application, so each directive is the
  # narrowest thing that still works:
  #
  #   script-src 'self'      — Vite emits hashed files; no inline script, no
  #                            eval. https://www.googletagmanager.com is
  #                            allowlisted for GA4's gtag.js only — without it
  #                            the browser silently blocks the script load and
  #                            no analytics ever reaches GA4, with only a CSP
  #                            violation in the console to show for it.
  #   style-src  … 'unsafe-inline'
  #                          — React sets element styles for the pointer and
  #                            annotation overlays, whose values are computed at
  #                            runtime and cannot be hashed
  #   img-src    … blob:     — video poster frames; https://www.google-analytics.com
  #                            covers GA4's no-JS pixel fallback
  #   media-src  blob:       — the MediaStream attached to the <video> element
  #   connect-src … wss:     — the signalling service, and the API (the
  #                            trailing `https:` scheme-source already permits
  #                            GA4's collect beacon, so no addition needed there)
  #   frame-ancestors 'none' — Remote must never be embedded; a framed screen
  #                            share is a screen share the user cannot see the
  #                            context of
  #
  # AICOUNTLY Connect (the embedded widget, src/connect/): its loader.js and
  # widget.js (script-src), widget.css — a <link> inside the widget's shadow
  # root, which style-src still governs — and its static images (img-src) come
  # from the Connect origin, production and sandbox. Its API calls are plain
  # https fetches (connect-src, listed explicitly though `https:` already
  # covers them). It uses no frames, fonts or workers of its own, so nothing
  # else is opened up. Permissions-Policy is deliberately unchanged: a Connect
  # audio call uses the microphone Remote already allows; `camera=()` stays, so
  # a Connect video call cannot start here.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.aicountly.com https://connect.gh.aicountly.com; style-src 'self' 'unsafe-inline' https://connect.aicountly.com https://connect.gh.aicountly.com; img-src 'self' data: blob: https://www.google-analytics.com https://connect.aicountly.com https://connect.gh.aicountly.com; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://my.aicountly.com https://connect.aicountly.com https://connect.gh.aicountly.com wss: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Deny access to any dotfile that somehow lands in the docroot (e.g. .env),
# except .well-known which must stay reachable for SSL renewal.
RedirectMatch 404 /\.(?!well-known)
