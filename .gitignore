# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Environment files — NEVER commit real credentials or endpoints.
# .env.example is the tracked template; everything else stays local.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# CodeIgniter's runtime log directory needs to exist on a fresh deploy target,
# the same as writable/cache, session, uploads and debugbar — git cannot track
# an empty directory, so its placeholder must survive the blanket `logs/` rule
# above. Without this, PHP's file logger fails silently (fopen() on a missing
# directory just returns false) and a production 500 leaves no trace anywhere.
!/backend/writable/logs/
!/backend/writable/logs/index.html

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Tooling caches
.eslintcache
*.tsbuildinfo
.cache/

# --- Desktop agent ---------------------------------------------------------
# Cargo's build directory. `desktop/Cargo.lock` is NOT ignored: a
# remote-control agent is not a place to discover that a transitive dependency
# changed between two builds of the same tag.
/desktop/target/
/desktop/src-tauri/target/
# Tauri's generated schemas and capability output.
/desktop/src-tauri/gen/
# Installer artifacts. Built by the release workflow, never committed.
/desktop/installers/windows/out/
/desktop/installers/macos/out/
